# =============================================================================
# ServiceWatch Environment Configuration Template
# =============================================================================
# Copy this file to .env or set environment variables in your terminal/system.
# Do NOT commit production credentials to source control.
# =============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/servicewatch

# SMTP Mail Delivery Settings (for Downtime & Recovery Alert Emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-alerts-email@gmail.com
MAIL_PASSWORD=your-google-app-password

# Application Host URL
APP_BASE_URL=http://localhost:8080

# Initial Bootstrap Administrator Credentials (Created automatically on 1st startup)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@servicewatch.local
FIRST_ADMIN_PASSWORD=Admin@12345
